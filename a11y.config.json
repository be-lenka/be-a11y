{
  "rules": {
    "alt-attributes": true,
    "redundant-title": true,
    "alt-too-long": true,
    "aria-invalid": true,
    "aria-role-invalid": true,
    "contrast": true,
    "empty-link": true,
    "heading-empty": true,
    "heading-order": true,
    "iframe-title-missing": true,
    "label-missing-for": true,
    "missing-landmark": true,
    "link-new-tab-warning": true,
    "missing-aria": true,
    "multiple-h1": true,
    "input-unlabeled": true,
    "html-lang": true,
    "document-title": true,
    "duplicate-id": true,
    "empty-button": true,
    "tabindex-positive": true,
    "meta-viewport": true,
    "table-headers": true,
    "meta-refresh": true,
    "skip-link": true,
    "fieldset-legend": true,
    "autocomplete-valid": true,
    "list-structure": true,
    "media-captions": true,
    "accesskey-duplicate": true,
    "deprecated-elements": true
  },
  "options": {
    "alt-attributes": {
      "maxLength": 125
    },
    "link-new-tab": {
      "phrases": [],
      "extraClasses": []
    }
  },
  "allowedExtensions": {
    ".latte": true,
    ".html": true,
    ".php": true,
    ".twig": true,
    ".edge": true,
    ".tsx": true,
    ".jsx": true
  },
  "excludedDirs": {
    "node_modules": true,
    "vendor": true,
    "dist": true,
    "build": true,
    "temp": true,
    ".idea": true,
    ".git": true,
    "log": true,
    "bin": true
  }
}
